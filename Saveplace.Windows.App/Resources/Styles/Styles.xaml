<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:Saveplace.Windows.App.Converters">

    <!-- Registrando nossos conversores para que o XAML possa usá-los -->
    <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
    <converters:ActiveProfileToColorConverter x:Key="ActiveProfileToColorConverter" />
    <converters:NullToBoolConverter x:Key="NullToBoolConverter" />

    <!-- Estilos Globais -->
    <Style TargetType="Border">
        <Setter Property="Stroke" Value="#e2e8f0" />
        <Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="#4f46e5" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="14,10" />
    </s:Style>
</ResourceDictionary>
