<Window x:Class="Saveplace.WindowsApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Saveplace.WindowsApp"
        xmlns:vm="clr-namespace:Saveplace.WindowsApp.ViewModels"
        mc:Ignorable="d"
        Title="Saveplace Monitor" Height="720" Width="1080"
        Background="#FEF7FF"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- Map Area -->
        <Border Grid.Column="0" Background="White" CornerRadius="16" Margin="0,0,16,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2" />
            </Border.Effect>
            <Grid>
                <TextBlock Text="Mapa em Tempo Real" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAA" />
                <!-- Placeholder for Map Control (e.g. WebView2 or GMap.NET) -->
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Status}" Foreground="Red" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Sidebar -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Monitoramento" FontSize="24" FontWeight="Bold" Foreground="#1D1B20" Margin="0,0,0,16"/>

            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="12" Margin="0,0,0,12" Padding="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="5" Opacity="0.1" ShadowDepth="1"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="40" Height="40" Fill="#EADDFF" Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding MedicalCondition}" FontSize="12" Foreground="Gray"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" Background="#E8DEF8" CornerRadius="8" Padding="8,4">
                                        <TextBlock Text="{Binding HeartRate, StringFormat='{} {0} BPM'}" FontWeight="Bold" FontSize="12" Foreground="#1D1B20"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
